# Zkopírujte na .env a doplňte. Pro fáze 1-2 (data, trénink, paper trading) nic nepotřebujete.

# --- Fáze 3: reálné peníze (nechte prázdné, dokud paper trading neprokáže edge) ---
# Privátní klíč Polygon peněženky s USDC. NIKDY necommitovat, NIKDY nesdílet.
POLYBOT_PRIVATE_KEY=
# Pojistka: live trading se odmítne spustit bez přesně této hodnoty.
# POLYBOT_LIVE=I_UNDERSTAND_REAL_MONEY

# --- Volitelné ladění ---
# POLYBOT_DATA_DIR=data
# POLYBOT_MODEL_DIR=models
# POLYBOT_FEE_BPS=100          # počítaný poplatek+skluz v bps (1 % = 100)
# POLYBOT_EDGE_THRESHOLD=0.05  # minimální edge modelu vs. cena
# POLYBOT_KELLY_SCALE=0.25     # zlomek plného Kellyho
# POLYBOT_MAX_POSITION_FRAC=0.05   # max podíl bankrollu na jeden trh
# POLYBOT_MAX_EXPOSURE_FRAC=0.5    # max podíl bankrollu v otevřených pozicích
# POLYBOT_DAILY_LOSS_LIMIT_FRAC=0.05  # denní stop-loss (kill-switch)
# POLYBOT_MIN_VOLUME=10000     # min objem trhu v USD
