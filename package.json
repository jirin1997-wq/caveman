{
  "name": "atc-radio-app",
  "version": "1.0.0",
  "description": "Live ATC Radio Simulation - Prague Airport (LKPR)",
  "private": true,
  "main": "electron-main.js",
  "author": {
    "name": "ATC Radio Team",
    "email": "user@atc-radio.local"
  },
  "homepage": "https://github.com",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "next dev",
    "dev:electron": "concurrently \"npm run dev:server\" \"wait-on http://localhost:3001/api/airports && electron .\"",
    "build": "next build",
    "build:electron": "electron-builder",
    "start": "next start",
    "electron": "electron .",
    "test": "node --test tests/*.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.6.2",
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "ws": "^8.14.2",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^2.0.0",
    "eslint": "^8.50.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.atc-radio.app",
    "productName": "ATC Radio",
    "files": [
      "electron-main.js",
      "preload.js",
      "server/**/*",
      "web/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": false,
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
